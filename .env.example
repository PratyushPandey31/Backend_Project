# AI Real Estate Portfolio Analyst - Configuration

# OpenRouter or OpenAI Model Gateway API Key (Optional - System works out-of-the-box with built-in Autonomous Engine)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Default Model Selection for OpenRouter Gateway
DEFAULT_MODEL=google/gemini-2.5-flash
FAST_MODEL=meta-llama/llama-3.3-70b-instruct
FALLBACK_MODEL=openai/gpt-4o-mini

# Database Configuration (Defaults to SQLite in local workspace)
DATABASE_URL=sqlite:///./portfolio.db

# Server Host & Port
HOST=127.0.0.1
PORT=8000
